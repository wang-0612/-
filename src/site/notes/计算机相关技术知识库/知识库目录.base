filters: file.ext == "md"
properties:
  file.folder:
    displayName: 分区
  tags:
    displayName: 标签
views:
  - type: table
    name: 全部笔记
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
      - tags
      - file.mtime
    summaries:
      file.mtime: Latest
  - type: list
    name: Linux
    filters:
      and:
        - file.inFolder("计算机相关技术知识库/01-Linux")
    order:
      - file.name
  - type: list
    name: Windows
    filters:
      and:
        - file.inFolder("计算机相关技术知识库/02-Windows")
    order:
      - file.name
  - type: list
    name: 数据库
    filters:
      and:
        - file.inFolder("计算机相关技术知识库/03-数据库")
    order:
      - file.name
  - type: list
    name: 速查表
    filters:
      and:
        - file.inFolder("计算机相关技术知识库/04-速查表")
    order:
      - file.name
